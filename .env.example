# Copy this file to .env and fill in your real values.
# Never commit the actual .env file -- it's already in .gitignore.

# ---------------------------------------------------------------------------
# LLM provider: set ANY ONE of the four API keys below and the pipeline
# auto-detects which provider to use (app/llm_providers/__init__.py).
# If more than one key is set, LLM_PROVIDER picks explicitly -- otherwise
# the auto-detect priority order is groq, then gemini, then anthropic,
# then openai. If you have multiple keys in this file (e.g. left over from
# testing) and want to force a specific one regardless of that order,
# uncomment LLM_PROVIDER below.
# ---------------------------------------------------------------------------

# Currently using Anthropic (Claude) -- uncomment and fill in your key.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5

# Force the provider explicitly rather than relying on auto-detect priority
# -- needed if you have more than one provider key set at once, since Groq
# is checked first by default.
LLM_PROVIDER=anthropic

# --- Other supported providers (uncomment whichever you're using instead) ---

# GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-3.5-flash

# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-5.1

# ---------------------------------------------------------------------------
# Concurrency: how many periods generate at once. Default is 1.
# Groq's free tier binds on tokens/minute (12000 TPM), not requests/minute,
# so raising this on a token-limited tier makes hitting a rate limit MORE
# likely, not less. Claude and OpenAI's paid tiers are generally more
# generous on TPM -- raise this if you're not seeing rate-limit retries in
# the logs and want faster runs.
# ---------------------------------------------------------------------------
# PERIOD_GENERATION_CONCURRENCY=1
